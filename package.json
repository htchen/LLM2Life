{
  "name": "llm2life",
  "version": "1.0.0",
  "private": true,
  "description": "三小時開放式專題工作坊：用 Claude Code + GitHub 把發想做成可操作工具",
  "scripts": {
    "slides": "marp workshop/slides/deck.md --html --allow-local-files -o dist/deck.html",
    "slides:pdf": "marp workshop/slides/deck.md --html --pdf --allow-local-files -o dist/deck.pdf",
    "slides:watch": "marp workshop/slides/deck.md --html --allow-local-files --preview --watch",
    "slides:paid": "marp workshop-paid/slides/deck.md --html --allow-local-files -o dist/deck-paid.html",
    "talk": "marp talk/deck.md --html --allow-local-files -o dist/talk.html",
    "talk:pdf": "marp talk/deck.md --html --pdf --allow-local-files -o dist/talk.pdf",
    "site": "open workshop/site/index.html || xdg-open workshop/site/index.html"
  },
  "devDependencies": {
    "@marp-team/marp-cli": "^4.0.0"
  }
}
